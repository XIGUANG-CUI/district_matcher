+        "parent_code": parent or None, "province_code": None, "city_code": None,
+        "id": code, "pid": parent or None,
+    }
+
+
+FIXTURE_ROWS = [
+    _row("110000000000", "北京市", 1),
+    _row("110100000000", "市辖区", 2, "110000000000"),
+    _row("110101000000", "东城区", 3, "110100000000"),
