+# -*- coding: utf-8 -*-
+"""区划匹配性能基准（可复现）。
+
+用法（仓库根目录）：
+    python scripts/bench_district_match.py --pack data/district_pack.tsv.gz
+
+说明：
+- 自动创建临时 USER_DATA_DIR，不触碰真实 student.db；
+- 全量导入数据包（664,239 行）后测 warm_cache / 单条 / 3000 行批量；
+- 输出供 CHANGES.md §6 引用的实测数字。
+"""
+import argparse
+import os
+import sys
+import tempfile
+import time
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+os.environ.setdefault('USER_DATA_DIR', tempfile.mkdtemp(prefix='dm_bench_'))
+
+import models  # noqa: E402
+from models import district as dm  # noqa: E402
+
+SAMPLES = [
+    ('230104199001010011', '黑龙江省哈尔滨市道外区水泥路1号'),
+    ('110108199001010022', '北京市海淀区中关村大街1号'),
+    ('440305199001010033', '广东省深圳市南山区科技园南区'),
+    ('320509199001010044', '江苏省苏州市吴江区松陵镇'),
+    ('231183199001010055', '黑龙江省黑河市嫩江市嫩江镇'),
+    ('500120199001010066', '重庆市璧山区璧城街道'),
+    ('230105199001010077', '黑龙江省哈尔滨市太平区'),
+    ('', '黑龙江省哈尔滨市道外区水泥路街道水泥路社区'),
+]
+
+
+def main():
+    parser = argparse.ArgumentParser(description='区划匹配性能基准')
+    parser.add_argument('--pack', default=os.path.join(ROOT, 'data', 'district_pack.tsv.gz'))
+    parser.add_argument('--rows', type=int, default=3000)
+    args = parser.parse_args()
+
+    models.init_db()
+
+    started = time.perf_counter()
+    result = dm.import_dictionary(pack_file=args.pack)
+    print('import_seconds=%.2f total=%s by_level=%s'
+          % (time.perf_counter() - started, result.get('total'), result.get('by_level')))
+
+    started = time.perf_counter()
+    info = dm.warm_cache()
+    print('warm_seconds=%.2f rows=%s history_rows=%s'
+          % (time.perf_counter() - started, info.get('rows'), info.get('history_rows')))
+
+    rows = [{'id_card': SAMPLES[i % len(SAMPLES)][0],
+             'address': SAMPLES[i % len(SAMPLES)][1]} for i in range(args.rows)]
+    started = time.perf_counter()
+    dm.fill_district_fields_many(rows)
+    elapsed = time.perf_counter() - started
+    hits = sum(1 for r in rows if r.get('district_county_code'))
+    print('many_%d_seconds=%.3f per_row_ms=%.3f hits=%d'
+          % (args.rows, elapsed, elapsed * 1000 / args.rows, hits))
+
+    started = time.perf_counter()
+    for i in range(200):
+        dm.fill_district_fields({'id_card': SAMPLES[i % len(SAMPLES)][0],
+                                 'address': SAMPLES[i % len(SAMPLES)][1]}, dm.get_db())
+    print('single_row_ms=%.3f' % ((time.perf_counter() - started) * 1000 / 200))
+    print('district_db_bytes=%d' % os.path.getsize(dm.DISTRICT_DB_PATH))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/build_district_pack.py b/scripts/build_district_pack.py
new file mode 100644
index 0000000..7d589d3
--- /dev/null
+++ b/scripts/build_district_pack.py
@@ -0,0 +1,114 @@
+# -*- coding: utf-8 -*-
+"""生成 district_pack.tsv.gz（可复现：固定排序 + gzip mtime=0）。
+
+用法（在仓库根目录）：
+    python scripts/build_district_pack.py \
+        --source database/district_matcher.db \
+        --out data/district_pack.tsv.gz \
+        --max-level 5
+
+产出：
+    data/district_pack.tsv.gz   6 列 TSV（district_code/name/admin_level/parent_code/province_code/city_code）
+    data/district_pack.sha256   sha256 + 行数 + 各级行数 + 字节数
+
+不依赖 pandas / numpy，仅标准库。
+"""
+import argparse
+import gzip
+import hashlib
+import os
+import sqlite3
+import sys
+
+EXPECTED_TOTAL = 664239
+EXPECTED_LEVELS = {1: 31, 2: 343, 3: 3255, 4: 41274, 5: 619336}
+HEADER = "district_code\tdistrict_name\tadmin_level\tparent_code\tprovince_code\tcity_code\n"
+
+
+def build(source, out_path, max_level=5, verify=True):
+    conn = sqlite3.connect(source)
+    conn.row_factory = sqlite3.Row
+    try:
+        rows = conn.execute(
+            "SELECT id, district_code, district_name, admin_level, pid, "
+            "province_code, city_code FROM t_district_code "
+            "WHERE admin_level <= ? ORDER BY admin_level, district_code",
+            (max_level,)).fetchall()
+        id_to_code = {r["id"]: r["district_code"] for r in rows}
+
+        os.makedirs(os.path.dirname(os.path.abspath(out_path)), exist_ok=True)
+        # mtime=0 + 固定压缩级别 => 同样输入得到同样字节（便于 sha256 验收）
+        with open(out_path, "wb") as raw:
+            with gzip.GzipFile(filename="", mode="wb", fileobj=raw,
+                               compresslevel=9, mtime=0) as gz:
+                gz.write(HEADER.encode("utf-8"))
+                counts = {}
+                total = 0
+                for r in rows:
+                    code = r["district_code"]
+                    parent = id_to_code.get(r["pid"], "") if r["pid"] else ""
+                    line = "%s\t%s\t%d\t%s\t%s\t%s\n" % (
+                        code, r["district_name"], r["admin_level"], parent,
+                        r["province_code"] or "", r["city_code"] or "")
+                    gz.write(line.encode("utf-8"))
+                    total += 1
+                    counts[r["admin_level"]] = counts.get(r["admin_level"], 0) + 1
+    finally:
+        conn.close()
+
+    size = os.path.getsize(out_path)
+    h = hashlib.sha256()
+    with open(out_path, "rb") as f:
+        for block in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(block)
+    digest = h.hexdigest()
+
+    summary = {
+        "total": total,
+        "by_level": dict(sorted(counts.items())),
+        "size": size,
+        "sha256": digest,
+        "max_level": max_level,
+    }
+
+    sha_path = os.path.splitext(out_path)[0] + ".sha256"
+    with open(sha_path, "w", encoding="utf-8") as f:
+        f.write("# district_pack.tsv.gz 校验信息（由 scripts/build_district_pack.py 生成）\n")
+        f.write("sha256  %s\n" % digest)
+        f.write("size    %d\n" % size)
+        f.write("total   %d\n" % total)
+        f.write("levels  " + " ".join("%d:%d" % kv for kv in sorted(counts.items())) + "\n")
+
+    print("数据包：%s" % out_path)
+    print("sha256：%s" % digest)
+    print("大小  ：%d 字节（%.2f MB）" % (size, size / 1024.0 / 1024.0))
+    print("行数  ：%d" % total)
+    print("各级  ：%s" % summary["by_level"])
+
+    if verify and max_level == 5:
+        if total != EXPECTED_TOTAL or dict(counts) != EXPECTED_LEVELS:
+            print("警告：行数与文档 2.4 不一致（期望 total=%d, levels=%s）"
+                  % (EXPECTED_TOTAL, EXPECTED_LEVELS))
+    return summary
+
+
+def main():
+    parser = argparse.ArgumentParser(description="生成区划字典数据包")
+    parser.add_argument("--source", default=os.path.join("database", "district_matcher.db"),
+                        help="源字典库（含 t_district_code）")
+    parser.add_argument("--out", default=os.path.join("data", "district_pack.tsv.gz"),
+                        help="输出数据包路径")
+    parser.add_argument("--max-level", type=int, default=5,
+                        help="最大层级：5=全量（默认）；4=仅省/市/区县（应急降级）")
+    parser.add_argument("--no-verify", action="store_true", help="跳过行数校验")
+    args = parser.parse_args()
+
+    if not os.path.exists(args.source):
+        print("源库不存在：%s" % args.source, file=sys.stderr)
+        return 1
+    build(args.source, args.out, max_level=args.max_level, verify=not args.no_verify)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
