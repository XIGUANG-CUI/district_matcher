+    <div>
+      <h4 class="mb-1"><i class="bi bi-geo-alt"></i> 区划匹配</h4>
+      <div class="text-muted small">身份证前 6 位 + 地址文本双引擎匹配；结果写入批次记录，不直接改学生主表（除“批量补全区划”）。</div>
+    </div>
+    <div class="d-flex gap-2">
+      <button type="button" class="btn btn-outline-secondary btn-sm" id="dm-refresh-dict">
+        <i class="bi bi-arrow-clockwise"></i> 刷新字典状态
+      </button>
+      <button type="button" class="btn btn-outline-primary btn-sm" id="dm-backfill-btn" data-limit="5000">
+        <i class="bi bi-magic"></i> 批量补全区划（≤5000）
+      </button>
+    </div>
+  </div>
+
+  <div class="row g-3">
+    <!-- 1. 单条查询 -->
+    <div class="col-12 col-xl-5">
+      <div class="card h-100">
+        <div class="card-header"><i class="bi bi-search"></i> 单条查询</div>
+        <div class="card-body">
+          <form id="dm-query-form" autocomplete="off">
+            <div class="mb-2">
+              <label class="form-label small text-muted" for="dm-id-card">身份证号（或 6 位区划代码）</label>
+              <input type="text" class="form-control" id="dm-id-card" maxlength="18"
+                     placeholder="可留空，与地址二选一">
+            </div>
+            <div class="mb-2">
+              <label class="form-label small text-muted" for="dm-address">地址</label>
+              <textarea class="form-control" id="dm-address" rows="2"
+                        placeholder="例：黑龙江省哈尔滨市道外区××街道"></textarea>
+            </div>
+            <button type="submit" class="btn btn-primary btn-sm" id="dm-query-btn">
+              <i class="bi bi-search"></i> 查询
+            </button>
+          </form>
+          <hr>
+          <div id="dm-query-summary" class="mb-2 text-muted small">尚未查询</div>
+          <dl class="row mb-0 small" id="dm-query-fields">
