+     data-export-url="{{ url_for('district_match.export_batch', batch_id=0) }}"
+     data-delete-url="{{ url_for('district_match.delete_batch', batch_id=0) }}"
+     data-dictionary-url="{{ url_for('district_match.dictionary') }}"
+     data-dict-import-url="{{ url_for('district_match.dictionary_import') }}"
+     data-history-url="{{ url_for('district_match.history') }}"
+     data-backfill-url="{{ url_for('district_match.backfill') }}">
+
