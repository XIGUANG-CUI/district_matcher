@@ -18,6 +18,110 @@ from config import DATABASE_PATH, PHOTOS_DIR
 logger = logging.getLogger(__name__)
 
 
+# ============================================================
+# 区划字典（district.db）DDL —— 由 models.district.import_dictionary 执行
+# 该库独立于 student.db，不参与备份；运行期只读，仅导入时一次性写入
+# ============================================================
+DISTRICT_DDL = """
