+{% extends "base.html" %}
+{% block title %}区划匹配{% endblock %}
+
+{% block content %}
+<div class="container-fluid py-3" id="dm-app"
+     data-query-url="{{ url_for('district_match.query') }}"
+     data-preview-url="{{ url_for('district_match.preview') }}"
+     data-batch-url="{{ url_for('district_match.batch') }}"
+     data-progress-url="{{ url_for('district_match.progress', progress_id='__PID__') }}"
+     data-batches-url="{{ url_for('district_match.batches') }}"
